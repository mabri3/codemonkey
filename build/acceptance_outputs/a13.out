---
providers:
  local:
    protocol: openai
    base_url: http://192.168.50.113:8080/v1
    model: Qwen3.8-27B-NVFP4-MTP-VERY-HIGH.gguf
    api_key_env: CODEMONKEY_API_KEY
    tool_protocol: auto
  anthropic:
    protocol: anthropic
    base_url: http://192.168.50.176:8080/v1
    model: unsloth/Qwen3.8-27B-GGUF
    api_key_env: ANTHROPIC_API_KEY
    tool_protocol: native
    api_key: '***'
default_provider: anthropic
sandbox: workspace-write
approval: on-request
max_turns: 30
timeout_seconds: 240
add_dirs: []
web_fetch: false
context_limit: 32000
project_instructions: true
verify_command: ''
max_verify_retries: 1
max_edit_retries: 1
observation_budget: 24000
repo_map: false
repo_map_budget: 4000
max_retries: 3
permissions:
  rules: []
fallback_provider: ''
prompt_cache: true
strategies:
  compaction: summarizing
  memory: file
  session_state: jsonl
